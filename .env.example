# postgres://user:pass@host:5432/db in production; pglite://<dir> or pglite://memory locally
DATABASE_URL=pglite://.data/pg
PORT=3000
# api | worker | all
ROLE=all
# Required in production (min 16 chars). Used for POST /v1/merchants.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Required in production (min 32 chars). Signs payment-scoped customer status tokens.
CUSTOMER_TOKEN_SECRET=change-me-to-another-long-random-string-32-chars
WORKER_POLL_MS=1000
MOCK_PSPS=pspA,pspB
# MOCK_PSP_RATES={"pspA":{"bankUnavailable":0.2,"timeout":0.05}}
