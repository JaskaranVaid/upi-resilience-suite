# Copy this file to .env (gitignored) — the server, demos and smoke test load it automatically.
# postgres://user:pass@host:5432/db in production; pglite://<dir> or pglite://memory locally
DATABASE_URL=pglite://.data/pg
PORT=3000
# api | worker | all | migrate (apply migrations and exit; `npm run db:migrate` does the same)
ROLE=all
# Apply migrations when a process starts: default true, false in production (the deploy migrates once).
# MIGRATE_ON_START=true
# Postgres connections per process.
# DATABASE_POOL_MAX=10
# Required in production (min 16 chars). Used for POST /v1/merchants.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Required in production (min 32 chars). Signs payment-scoped customer status tokens.
CUSTOMER_TOKEN_SECRET=change-me-to-another-long-random-string-32-chars
WORKER_POLL_MS=1000
# Graceful shutdown: report not-ready for this long before closing (behind a load balancer: 5000).
# SHUTDOWN_DRAIN_MS=0
# SHUTDOWN_TIMEOUT_MS=25000
# The worker logs an ops.metrics line (the production alarms' source) this often; 0 = off.
# OPS_METRICS_INTERVAL_MS=60000
# Worker heartbeat for the container health check (default: <tmp>/merchantflo-worker.heartbeat),
# and how old it may get before the worker counts as stuck.
# HEARTBEAT_FILE=
# WORKER_STALL_MS=600000
# Proxies in front of the API: false, a hop count (1 behind one load balancer) or proxy CIDRs.
TRUST_PROXY=false
# public-only (default in production): merchant webhooks must be https on public hosts.
# any (default elsewhere): any http(s) URL, e.g. http://localhost for local development.
# WEBHOOK_TARGETS=public-only
# Shared adapters (test-mode merchants only). Live merchants connect their own PSP accounts.
MOCK_PSPS=pspA,pspB
# Key ring sealing merchants' PSP credentials: "k2:<base64 32 bytes>,k1:<…>" (first = active).
# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CREDENTIALS_KEYS=k1:...
# Customers' VPAs and phone numbers are sealed at rest with a key derived from CREDENTIALS_KEYS.
# After turning it on for old data or rotating keys, run: npm run privacy:backfill
# ENCRYPT_PERSONAL_FIELDS=true
# Public URL of this API, used to show each PSP connection's webhook URL.
# PUBLIC_BASE_URL=https://api.example.in
# IST date the UPI MDR regime starts. Leave unset until NPCI confirms it (the announced
# 15 Oct 2026 start was postponed); while unset, UPI is quoted as free and no steering happens.
# MDR_EFFECTIVE_FROM=2026-11-16
# Shared Cashfree *sandbox* account for test-mode merchants (optional). Live Cashfree keys are refused
# here: they belong to the merchant (POST /v1/psp-connections).
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
# CASHFREE_ENV=sandbox
# In production, mock PSPs refuse to start unless ALLOW_MOCK_PSPS=true.
# MOCK_PSP_RATES={"pspA":{"bankUnavailable":0.2,"timeout":0.05}}
